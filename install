#!/usr/bin/env bash
# Install this repo into Claude Code (as the plugin `sf`: /sf:build, /sf:ship...)
# and Codex (skill links), and load PRINCIPLES.md in both.
# Whatever a link replaces moves to a timestamped backup; nothing is deleted.
# Safe to run again.
set -euo pipefail

REPO=$(cd "$(dirname "$0")" && pwd)
BACKUP="$HOME/.agents/skills-backup/$(date +%Y%m%d-%H%M%S)"
# Skills this repo replaces. Moved to the backup if present.
RETIRED="always-ponytail ponytail babysit-pr council file-pr full-send full-stop leaving-pr-comments modernize sol-loop takeover"

stash() {  # stash <path> <backup subfolder>
  [ -e "$1" ] || [ -L "$1" ] || return 0
  mkdir -p "$BACKUP/$2"
  mv "$1" "$BACKUP/$2/"
  echo "backed up  $1"
}

link() {  # link <target> <path> <backup subfolder>
  [ "$(readlink "$2" 2>/dev/null)" = "$1" ] && return 0
  stash "$2" "$3"
  mkdir -p "$(dirname "$2")"
  ln -s "$1" "$2"
  echo "linked     $2"
}

for name in $RETIRED; do
  [ -d "$REPO/skills/$name" ] && continue  # one of ours, handled below
  stash "$HOME/.claude/skills/$name" claude
  stash "$HOME/.agents/skills/$name" agents
done

for dir in "$REPO"/skills/*/; do
  name=$(basename "$dir")
  # Claude Code gets these through the plugin; a plain link would add /<name> next to /sf:<name>.
  if [ "$(readlink "$HOME/.claude/skills/$name" 2>/dev/null)" = "$REPO/skills/$name" ]; then
    rm "$HOME/.claude/skills/$name"
    echo "unlinked   $HOME/.claude/skills/$name (now /sf:$name)"
  fi
  link "$REPO/skills/$name" "$HOME/.agents/skills/$name" agents  # Codex
done

# Claude Code: this folder is its own marketplace. Its plugin is read from the
# folder itself, so an edit here applies after /reload-plugins, with no reinstall.
if ! claude plugin marketplace list | grep -q 'software-factory'; then
  claude plugin marketplace add "$REPO"
fi
if ! claude plugin list | grep -q 'sf@software-factory'; then
  claude plugin install sf@software-factory
fi

# Claude Code: import the principles from the global CLAUDE.md.
import="@$REPO/PRINCIPLES.md"
touch "$HOME/.claude/CLAUDE.md"
if ! grep -qxF "$import" "$HOME/.claude/CLAUDE.md"; then
  printf '\n%s\n' "$import" >> "$HOME/.claude/CLAUDE.md"
  echo "imported   PRINCIPLES.md in ~/.claude/CLAUDE.md"
fi

# Codex has no imports: its global AGENTS.md is the principles file itself.
link "$REPO/PRINCIPLES.md" "$HOME/.codex/AGENTS.md" codex

[ -d "$BACKUP" ] && echo "backup in  $BACKUP (move entries back to restore them)"
echo "done. Start a new session to load the skills."
